# Copy these values into the registered Zo HTTP Service's environment settings.
# This example contains no secrets; the server does not automatically load it.
# Zo injects PORT from the service's local_port setting (suggested: 4176).
HOST=127.0.0.1

# Persistent paths outside dist/ and outside the replaceable release directory.
# Use a separate directory for acceptance tests. Never upload local data/.
TQ_DATA_FILE=/home/workspace/tablequest-data/leaderboard.json
TQ_TELEMETRY_FILE=/home/workspace/tablequest-data/telemetry.jsonl

# New telemetry files rotate at 16 MiB; keep the active file and one .1 backup.
# An oversized pre-existing file may exceed this bound until its backup rotates.
# Both must be included when inspecting or privately backing up diagnostics.
TQ_TELEMETRY_MAX_BYTES=16777216

# Keep network hashing disabled unless there is a specific operational need.
# If enabled later, generate the salt on the server; do not commit its value.
TQ_TELEMETRY_IP_SALT=
